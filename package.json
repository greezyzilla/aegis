{
  "name": "aegis",
  "description": "Script blocker with per-domain allow rules",
  "private": true,
  "version": "0.2.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "sign:firefox": "npm run zip:firefox && web-ext sign --channel unlisted --source-dir dist/firefox-mv3 --artifacts-dir dist/signed --upload-source-code dist/aegis-$npm_package_version-sources.zip",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "wxt build && playwright test",
    "test:firefox": "wxt build -b firefox && node e2e-firefox/run.mjs dist/firefox-mv3"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.1.0",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "overrides": {
    "minimatch@^10.0.0": "11.0.3"
  }
}
